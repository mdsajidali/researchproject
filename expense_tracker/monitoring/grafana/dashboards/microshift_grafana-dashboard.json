{
  "id": null,
  "title": "MicroShift Expense Tracker - Performance Dashboard",
  "timezone": "browser",
  "panels": [
    {
      "type": "graph",
      "title": "CPU Usage (cAdvisor)",
      "targets": [
        { "expr": "sum(rate(container_cpu_usage_seconds_total[1m]))", "legendFormat": "CPU Usage" }
      ],
      "yaxes": [{ "format": "percent" }, { "format": "short" }]
    },
    {
      "type": "graph",
      "title": "Memory Usage (Bytes)",
      "targets": [
        { "expr": "sum(container_memory_usage_bytes)", "legendFormat": "Memory" }
      ],
      "yaxes": [{ "format": "bytes" }, { "format": "short" }]
    },
    {
      "type": "graph",
      "title": "HTTP Uptime (Blackbox Exporter)",
      "targets": [
        { "expr": "avg_over_time(probe_success[1m])", "legendFormat": "HTTP Success Ratio" }
      ],
      "yaxes": [{ "format": "percent" }, { "format": "short" }]
    }
  ],
  "schemaVersion": 16,
  "version": 1
}

